# ==============================================================================
# WellSync Environment Configuration Template
# Copy this file to .env and customize for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Security & Authentication (Generate a strong 32+ character key for production!)
# ------------------------------------------------------------------------------
JWT_SECRET=production-secret-wellsync-sih-2026-baghewala-heavy-oil-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ------------------------------------------------------------------------------
# Database Settings (TimescaleDB / PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=wellsync
POSTGRES_PASSWORD=wellsync_secure_password_replace_me
POSTGRES_DB=wellsync
DB_PORT=5432

# In Docker Compose, the host is 'db'. For external databases, use the full URI:
DATABASE_URL=postgresql://wellsync:wellsync_secure_password_replace_me@db:5432/wellsync
# For local SQLite development (fallback):
# DATABASE_URL=sqlite:///./wellsync.db

# ------------------------------------------------------------------------------
# Ingestion & Simulator Settings
# ------------------------------------------------------------------------------
# Set to 'false' if feeding live SCADA / OPC-UA / Historian CSV data
SIMULATOR_ENABLED=true
SIMULATOR_TICK_SECONDS=10

# ------------------------------------------------------------------------------
# Port Bindings (Host ports)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated or JSON list)
# ------------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000
